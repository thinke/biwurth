{
  "id": "ant-design",
  "name": "Ant Design",
  "description": "Light and quiet, after Ant Design's tokens: white bordered cards on grey, card titles over a line, switches, blue primary and the AntV chart colours.",
  "base": "light",
  "colors": {
    "background": "#f5f5f5",
    "card": "#ffffff",
    "text": "#1f1f1f",
    "muted": "#8c8c8c",
    "accent": "#1677ff",
    "onAccent": "#ffffff"
  },
  "font": "system",
  "textScale": 1,
  "tileOpacity": 100,
  "gap": 16,
  "animations": true,
  "cards": true,
  "tiles": {
    "radius": 8,
    "padding": 16,
    "borderWidth": 1,
    "borderColor": "#f0f0f0",
    "shadow": 1,
    "titleWeight": "bold",
    "titleColor": "text",
    "titleDivider": true,
    "valueWeight": "regular",
    "toggleStyle": "switch",
    "clockWeight": "regular",
    "graphLineWidth": 2,
    "graphFill": true,
    "graphGrid": true,
    "graphColors": [
      "#1783ff",
      "#00c9c9",
      "#f0884d",
      "#d580ff",
      "#7863ff",
      "#60c42d"
    ],
    "listDividers": true,
    "thermostatStyle": "numbers",
    "sliderStyle": "bar"
  },
  "background": {
    "type": "color",
    "color": "#f5f5f5"
  }
}
