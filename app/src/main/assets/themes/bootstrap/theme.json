{
  "id": "bootstrap",
  "name": "Bootstrap",
  "description": "Bootstrap 5.3: white cards with a card-header line on light grey, the primary blue, switches, light display numbers. Graphs follow Chart.js habits (grid, no fill); calendars follow the list group (lined rows).",
  "base": "light",
  "colors": {
    "background": "#f8f9fa",
    "card": "#ffffff",
    "text": "#212529",
    "muted": "#6c757d",
    "accent": "#0d6efd",
    "onAccent": "#ffffff"
  },
  "font": "system",
  "textScale": 1,
  "tileOpacity": 100,
  "gap": 16,
  "animations": true,
  "cards": true,
  "tiles": {
    "radius": 6,
    "padding": 16,
    "borderWidth": 1,
    "borderColor": "#dee2e6",
    "shadow": 1,
    "titleWeight": "medium",
    "titleColor": "text",
    "titleDivider": true,
    "valueWeight": "light",
    "clockWeight": "light",
    "toggleStyle": "switch",
    "graphLineWidth": 2,
    "graphFill": false,
    "graphGrid": true,
    "graphColors": [
      "#0d6efd",
      "#198754",
      "#fd7e14",
      "#dc3545",
      "#6f42c1",
      "#0dcaf0"
    ],
    "listDividers": true,
    "calendarColors": true,
    "tileLayout": "stacked",
    "icons": "none",
    "buttonShape": "card",
    "thermostatStyle": "numbers",
    "sliderStyle": "bar"
  },
  "background": {
    "type": "color",
    "color": "#f8f9fa"
  }
}
